# 本文件所有项均可选：留空时用默认值，或由管理界面写入 config.json。
# 代理鉴权密钥；默认为空（无鉴权），建议留空并在 /admin 管理界面生成后保存
PROXY_API_KEY=
# 管理端动态配置目录（存放 config.json 与 runtime-credentials.json）；
# 其中的配置优先于本文件。默认安装目录下的 .config/
KIRO_PROXY_CONFIG_DIRECTORY=/path/to/config-dir
DEFAULT_MODEL=auto
REQUEST_TIMEOUT_SECONDS=600
KIRO_WORKING_DIRECTORY=/path/to/workspace
KIRO_EFFORT=
RESPONSE_LANGUAGE=简体中文

MODEL_CACHE_ENABLED=true
MODEL_CACHE_TTL_SECONDS=300
MODEL_CACHE_STALE_SECONDS=3600

INCREMENTAL_STREAMING=true

# 凭据文件固定在 config.json 同目录下的 runtime-credentials.json，由程序
# 自动读写（SSO 登录/导入/刷新回写），无需在此配置路径。未配置凭据时服务
# 仍可正常启动，可先起服务再经管理界面登录；但在此之前生成请求会失败。
# 账户数组中要使用的零基索引；普通凭据对象留空
RUNTIME_ACCOUNT_INDEX=
# 可选：覆盖默认端点（留空则从 profile_arn 区域自动构造）
RUNTIME_ENDPOINT=
