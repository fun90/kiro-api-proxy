PROXY_API_KEY_FILE=/path/to/proxy-api-key
KIRO_CLI_PATH=kiro-cli
DEFAULT_MODEL=auto
MAX_CONCURRENCY=2
REQUEST_TIMEOUT_SECONDS=600
KIRO_WORKING_DIRECTORY=/path/to/workspace
# Linux/macOS 使用冒号分隔，Windows 使用分号分隔。
KIRO_EXTRA_PATH=
KIRO_EFFORT=
KIRO_TRUST_TOOLS=
RESPONSE_LANGUAGE=简体中文

MODEL_CACHE_ENABLED=true
MODEL_CACHE_TTL_SECONDS=300
MODEL_CACHE_STALE_SECONDS=3600

INCREMENTAL_STREAMING=true

# 安全默认关闭；完成本机 ACP 验收后开启。
ACP_ENABLED=false
ACP_MIN_WORKERS=1
ACP_MAX_WORKERS=2
ACP_QUEUE_SIZE=16

# 安全默认关闭；依赖 ACP 才能获得实际收益。
SESSION_REUSE_ENABLED=false
SESSION_TTL_SECONDS=1800
SESSION_MAX_ENTRIES=256
SESSION_MAX_TURNS=40
SESSION_MAX_CONTEXT_CHARS=200000
SESSION_COMPACTION_RATIO=0.7

# 直连 Runtime 实验传输（默认关闭，失败自动降级 ACP/CLI）。
# 启用前需准备凭据文件，参见 credentials.example.json。
RUNTIME_ENABLED=false
# 凭据 JSON 文件路径（含 refresh_token、client_id 等）
RUNTIME_CREDENTIALS_FILE=
# 账户数组中要使用的零基索引；普通凭据对象留空
RUNTIME_ACCOUNT_INDEX=
# 可选：覆盖默认端点（留空则从 profile_arn 区域自动构造）
RUNTIME_ENDPOINT=
TRANSPORT_PRIORITY=acp,cli
